# Copy this file to .env and fill in your values.
# Do NOT commit your real token / secrets to source control.

# Discord bot token (keep secret)
TOKEN=your_discord_bot_token_here

# Discord OAuth application credentials
CLIENT_ID=your_discord_client_id_here
CLIENT_SECRET=your_discord_client_secret_here

# Base URL used for OAuth redirect (no trailing slash)
BASE_URL=https://localhost:5000

# Force a specific redirect URI (optional)
# This should match your Discord OAuth redirect URI setting.
FORCE_REDIRECT_URI=https://localhost:5000/auth/discord/callback

# Optional: set to 'production' in production environments
NODE_ENV=development
